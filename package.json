{
  "name": "flash-info",
  "private": true,
  "version": "0.7.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @flash-info/web",
    "build": "npm run build -w @flash-info/web",
    "start": "npm run start -w @flash-info/web",
    "test": "npm run test -w @flash-info/core",
    "typecheck": "npm run typecheck -w @flash-info/core && npm run typecheck -w @flash-info/web",
    "health": "npm run health -w @flash-info/core"
  },
  "engines": { "node": ">=20" }
}
