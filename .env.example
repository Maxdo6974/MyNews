# Environnement de test
STAGING_PASSWORD=choisissez-un-mot-de-passe
DEMO_MODE=true            # true = contenus d'exemple, aucun appel API
DAILY_BUDGET_EUR=2        # plafond de dépenses API par jour

# Clés API (nécessaires à partir de l'étape 5, mode réel)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Base de données (étape 3) — sur Railway : référence ${{Postgres.DATABASE_URL}}
DATABASE_URL=
INGEST_INTERVAL_MIN=20    # fréquence de récupération des flux
INGEST_ENABLED=true

# IA (étape 5)
ANTHROPIC_MODEL=claude-sonnet-5-5
USD_TO_EUR=0.95

# Voix (étape 6)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_EUR_PER_MIN=0.02
AUDIO_TEMPO=1.08         # vitesse de la voix (0.9 à 1.25)
